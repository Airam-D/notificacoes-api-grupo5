						"size": 6228,
						"mimeType": "application/json; charset=utf-8",
						"text": "[{\"id\":2,\"tipo\":\"confirmacao\",\"destinatarioEmail\":\"airam.teste@gmail.com\",\"assunto\":\"Inscrição confirmada: Hackathon SENAI 2025\",\"conteudo\":\"\\n    <!DOCTYPE html>\\n    <html>\\n    <head>\\n      <meta charset=\\\"UTF-8\\\">\\n      <style>\\n        body {\\n          font-family: Arial, sans-serif;\\n          background-color: #f4f4f4;\\n          margin: 0;\\n          padding: 0;\\n        }\\n        .container {\\n          max-width: 600px;\\n          margin: 20px auto;\\n          background-color: #ffffff;\\n          border-radius: 8px;\\n          overflow: hidden;\\n          box-shadow: 0 2px 8px rgba(0,0,0,0.1);\\n        }\\n        .header {\\n          background-color: #2E75B6;\\n          color: white;\\n          padding: 20px;\\n          text-align: center;\\n        }\\n        .header h1 {\\n          margin: 0;\\n          font-size: 24px;\\n        }\\n        .body {\\n          padding: 30px;\\n          color: #333333;\\n          line-height: 1.6;\\n        }\\n        .footer {\\n          background-color: #f8f8f8;\\n          padding: 15px;\\n          text-align: center;\\n          font-size: 12px;\\n          color: #888888;\\n          border-top: 1px solid #eeeeee;\\n        }\\n        .btn {\\n          display: inline-block;\\n          background-color: #2E75B6;\\n          color: white;\\n          padding: 12px 24px;\\n          text-decoration: none;\\n          border-radius: 4px;\\n          margin: 10px 0;\\n        }\\n        .info-box {\\n          background-color: #f0f7ff;\\n          border-left: 4px solid #2E75B6;\\n          padding: 15px;\\n          margin: 15px 0;\\n          border-radius: 0 4px 4px 0;\\n        }\\n      </style>\\n    </head>\\n    <body>\\n      <div class=\\\"container\\\">\\n        <div class=\\\"header\\\">\\n          <h1>Plataforma de Eventos</h1>\\n        </div>\\n        <div class=\\\"body\\\">\\n          \\n    <h2>Inscrição Confirmada! ✅</h2>\\n    <p>Olá <strong>Airam</strong>,</p>\\n    <p>Sua inscrição foi confirmada com sucesso!</p>\\n\\n    <div class=\\\"info-box\\\">\\n      <p><strong>Evento:</strong> Hackathon SENAI 2025</p>\\n      <p><strong>Data:</strong> sábado, 20 de setembro de 2025</p>\\n      <p><strong>Local:</strong> SENAI - Auditório</p>\\n    </div>\\n\\n    <p>Prepare-se para uma experiência incrível! Se precisar cancelar sua inscrição,\\n    entre em contato com a organização.</p>\\n\\n    <p>Até lá! 🎉</p>\\n  \\n        </div>\\n        <div class=\\\"footer\\\">\\n          <p>Este é um e-mail automático. Por favor, não responda.</p>\\n          <p>&copy; 2025 Plataforma de Eventos — SENAI</p>\\n        </div>\\n      </div>\\n    </body>\\n    </html>\\n  \",\"dataEnvio\":\"2026-05-26T13:08:34.000Z\",\"enviada\":true,\"inscricaoId\":16,\"createdAt\":\"2026-05-26T13:08:34.000Z\",\"updatedAt\":\"2026-05-26T13:08:34.000Z\",\"inscricao_id\":16,\"inscricao\":{\"id\":16,\"dataInscricao\":\"2026-05-26T13:08:33.000Z\",\"status\":\"confirmada\",\"createdAt\":\"2026-05-26T13:08:33.000Z\",\"updatedAt\":\"2026-05-26T13:08:33.000Z\",\"evento_id\":10,\"participante_id\":24,\"evento\":{\"nome\":\"Hackathon SENAI 2025\"},\"participante\":{\"nome\":\"Airam\",\"email\":\"airam.teste@gmail.com\"}}},{\"id\":1,\"tipo\":\"confirmacao\",\"destinatarioEmail\":\"teste@example.com\",\"assunto\":\"Inscrição confirmada: Palestra sobre APIs REST\",\"conteudo\":\"\\n    <!DOCTYPE html>\\n    <html>\\n    <head>\\n      <meta charset=\\\"UTF-8\\\">\\n      <style>\\n        body {\\n          font-family: Arial, sans-serif;\\n          background-color: #f4f4f4;\\n          margin: 0;\\n          padding: 0;\\n        }\\n        .container {\\n          max-width: 600px;\\n          margin: 20px auto;\\n          background-color: #ffffff;\\n          border-radius: 8px;\\n          overflow: hidden;\\n          box-shadow: 0 2px 8px rgba(0,0,0,0.1);\\n        }\\n        .header {\\n          background